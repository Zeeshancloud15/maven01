pipeline {
    agent any

    environment {
        // Project info
        PROJECT_NAME = 'cicd-app'
        DOCKER_IMAGE = 'cicd-app-image'
        DOCKER_TAG   = 'latest'
        // Use your actual ECR repo
        ECR_REPO     = '189598237274.dkr.ecr.us-east-1.amazonaws.com/zeeshan-agency'
        SONAR_TOKEN  = 'sqa_98c6372414806bf45ffd18c23c076d102834c8ae'
    }

    stages {

        stage('Checkout SCM') {
            steps {
                echo 'Checking out source code from Git...'
                git branch: 'main', url: 'https://github.com/your-repo/cicd-app.git'
            }
        }

        stage('Build Maven') {
            steps {
                echo 'Building project with Maven...'
                sh 'mvn clean package -DskipTests'
            }
        }

        stage('SonarQube Scan') {
            steps {
                echo 'Running SonarQube analysis...'
                // Using provided Sonar token
                sh "mvn sonar:sonar -Dsonar.login=${SONAR_TOKEN} -Dmaven.compiler.source=21 -Dmaven.compiler.target=21"
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker image...'
                sh "docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} ."
            }
        }

        stage('Login AWS ECR') {
            steps {
                echo 'Logging in to AWS ECR...'
                // Use AWS CLI login (replace credentialsId if using Jenkins credentials)
                sh "aws ecr get-login-password --region us-east-1 | docker login --username AWS --password-stdin ${ECR_REPO}"
            }
        }

        stage('Push to ECR') {
            steps {
                echo 'Pushing Docker image to ECR...'
                sh "docker tag ${DOCKER_IMAGE}:${DOCKER_TAG} ${ECR_REPO}:${DOCKER_TAG}"
                sh "docker push ${ECR_REPO}:${DOCKER_TAG}"
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                echo 'Deploying to Kubernetes cluster...'
                // Ensure kubeconfig is available on Jenkins agent
                sh "kubectl apply -f k8s/deployment.yaml"
                sh "kubectl apply -f k8s/service.yaml"
            }
        }

        stage('Verify Deployment') {
            steps {
                echo 'Verifying deployment...'
                sh "kubectl get pods"
                sh "kubectl get svc"
            }
        }

    }

    post {
        always {
            echo 'Cleaning up workspace...'
            cleanWs()
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Please check the logs!'
        }
    }
}
