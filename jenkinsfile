pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = "189598237274"
        AWS_REGION = "us-east-1"
        ECR_REPO = "zeeshan-agency"
        IMAGE_TAG = "latest"
        DOCKER_IMAGE = "189598237274.dkr.ecr.us-east-1.amazonaws.com/zeeshan-agency:latest"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/Zeeshancloud15/maven01.git'
            }
        }

        stage('Build Maven') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t zeeshan-agency:latest .'
            }
        }

        stage('Login AWS ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region us-east-1 | \
                docker login --username AWS --password-stdin \
                189598237274.dkr.ecr.us-east-1.amazonaws.com
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                docker tag zeeshan-agency:latest $DOCKER_IMAGE
                docker push $DOCKER_IMAGE
                '''
            }
        }

        stage('Deploy Kubernetes') {
            steps {
                sh 'kubectl apply -f k8s-deployment.yaml'
                sh 'kubectl apply -f k8s-service.yaml'
            }
        }
    }
}
