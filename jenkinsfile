pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = "189598237274"
        AWS_REGION = "us-east-1"
        ECR_REPO = "zeeshan-agency"
        IMAGE_TAG = "latest"
        DOCKER_IMAGE = "189598237274.dkr.ecr.us-east-1.amazonaws.com/zeeshan-agency:latest"
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'main', url: 'https://github.com/Zeeshancloud15/maven01.git'
            }
        }

        stage('Build Maven') {
            steps {
                // Java 21 fix
                sh 'mvn clean package -Dmaven.compiler.source=21 -Dmaven.compiler.target=21'
            }
        }

        stage('SonarQube Scan') {
            steps {
                sh 'mvn sonar:sonar -Dmaven.compiler.source=21 -Dmaven.compiler.target=21'
            }
        }

        stage('Docker Build') {
            steps {
                sh 'docker build -t zeeshan-agency:latest .'
            }
        }

        stage('Login AWS ECR') {
            steps {
                sh '''
                aws ecr get-login-password --region $AWS_REGION | \
                docker login --username AWS --password-stdin $AWS_ACCOUNT_ID.dkr.ecr.$AWS_REGION.amazonaws.com
                '''
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                docker tag zeeshan-agency:latest $DOCKER_IMAGE
                docker push $DOCKER_IMAGE
                '''
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl apply -f k8s-deployment.yaml'
                sh 'kubectl apply -f k8s-service.yaml'
            }
        }

        stage('Verify Deployment') {
            steps {
                sh 'kubectl get pods'
                sh 'kubectl get svc'
            }
        }
    }

    post {
        always {
            echo "Pipeline finished. Check logs for details."
        }
    }
}
